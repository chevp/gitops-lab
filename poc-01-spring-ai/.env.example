# ── OpenAI ─────────────────────────────────────────────
# Referenziert in application.yml als ${OPENAI_API_KEY}
OPENAI_API_KEY=

# ── Optional: Model / Chat-Optionen ────────────────────
# (nur setzen, wenn du application.yml entsprechend erweiterst)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_CHAT_TEMPERATURE=0.7

# ── Optional: App-Chat-Limits (überschreibt application.yml) ─
# SPRING_APPLICATION_JSON kann Werte injizieren, oder relaxed binding:
# APP_CHAT_MAX_TOKENS=100
# APP_CHAT_MAX_INPUT_TOKENS=100
# APP_CHAT_MAX_TOKENS_PER_DAY=1000

# ── Optional: Server ───────────────────────────────────
# SERVER_PORT=8080
