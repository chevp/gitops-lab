# PoC 02 – zentrale Konfiguration. Vor dem ersten Lauf anpassen.
# Projekt-ID muss GLOBAL EINDEUTIG sein (a-z, 0-9, '-'; 6-30 Zeichen).

PROJECT_ID="gitops-lab-000000"
PROJECT_NAME="GitOps Lab"
REGION="europe-west6"

# Billing-Account-ID aus:  gcloud billing accounts list
# Leer lassen, um die Billing-Verknüpfung zu überspringen.
BILLING_ACCT=""

# Artifact-Registry-Docker-Repository (in REGION angelegt)
AR_REPO="gitops-lab-docker"
