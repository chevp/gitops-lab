# PoC 03 – zentrale Konfiguration. Vor dem ersten Lauf anpassen.
# Muss zu PoC 02 passen (gleiche PROJECT_ID / REGION).

PROJECT_ID="gitops-lab-000000"
REGION="europe-west6"

# Cluster
CLUSTER_NAME="gitops-lab"
# ZONAL (eine Zone, günstiger) vs. REGIONAL (mehrere Zonen, HA).
# Für ein Lab reicht zonal. Bei REGIONAL=true wird REGION als --region genutzt.
REGIONAL="false"
ZONE="europe-west6-a"

# Node-Pool
MACHINE_TYPE="e2-standard-2"
NUM_NODES="2"

# Kubernetes-Namespace für die App aus PoC 01
NAMESPACE="poc-01-spring-ai"
