# PoC 04 – zentrale Konfiguration. Vor dem ersten Lauf anpassen.
# Muss zu PoC 02/03 passen (gleiche PROJECT_ID / REGION / Registry / Cluster).

PROJECT_ID="gitops-lab-000000"
REGION="europe-west6"

# Artifact-Registry-Docker-Repo aus PoC 02
AR_REPO="gitops-lab-docker"

# Kubernetes / Namespace (aus PoC 03)
NAMESPACE="poc-01-spring-ai"

# --- Anwendung / Image ------------------------------------------------------
# Quellverzeichnis der App (PoC 01); relativ zu diesem PoC-Ordner.
APP_DIR="../poc-01-spring-ai"
IMAGE_NAME="poc-01-spring-ai"
IMAGE_TAG="0.1.0"

# --- Helm -------------------------------------------------------------------
RELEASE_NAME="poc-01-spring-ai"
CHART_DIR="chart"

# OpenAI-API-Key für die App. Leer lassen und stattdessen als Umgebungs-
# variable exportieren:  export OPENAI_API_KEY=sk-...
# Wird von 02-install.sh in ein Kubernetes-Secret geschrieben.
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
