# PoC 05 – zentrale Konfiguration. Vor dem ersten Lauf anpassen.
# Muss zu PoC 02/03/04 passen (gleiche PROJECT_ID / REGION / Registry / Cluster).

PROJECT_ID="gitops-lab-000000"
REGION="europe-west6"

# Artifact-Registry-Docker-Repo aus PoC 02
AR_REPO="gitops-lab-docker"

# Ziel-Namespace der Anwendung (aus PoC 03/04)
NAMESPACE="poc-01-spring-ai"

# --- Anwendung / Image (wie PoC 04) ----------------------------------------
IMAGE_NAME="poc-01-spring-ai"
IMAGE_TAG="0.1.0"

# --- Argo CD ----------------------------------------------------------------
ARGOCD_NAMESPACE="argocd"
# Install-Manifest-Version: "stable" oder ein Tag wie "v2.12.3".
ARGOCD_VERSION="stable"

# --- Git-Quelle (GitOps) ----------------------------------------------------
# Repository, das Argo CD beobachtet.
GIT_REPO_URL="https://github.com/chevp/gitops-lab.git"
GIT_TARGET_REVISION="main"
# Pfad zum Helm-Chart INNERHALB des Repos (aus PoC 04).
CHART_PATH="poc-04-helm/chart"

# --- Argo CD Application ----------------------------------------------------
APP_NAME="poc-01-spring-ai"
ARGOCD_PROJECT="default"

# --- OpenAI-Secret ----------------------------------------------------------
# Der Key gehört NICHT ins Git. Er wird von 04-app-secret.sh als eigenes
# Kubernetes-Secret angelegt und im Chart über openai.existingSecret
# referenziert (die Application setzt openai.existingSecret entsprechend).
OPENAI_SECRET_NAME="poc-01-spring-ai-openai"
# Leer lassen und stattdessen exportieren:  export OPENAI_API_KEY=sk-...
OPENAI_API_KEY="${OPENAI_API_KEY:-}"
